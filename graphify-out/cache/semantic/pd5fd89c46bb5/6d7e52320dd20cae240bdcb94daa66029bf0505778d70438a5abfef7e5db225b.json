e": "CHANGELOG.md", "source_location": "session 1", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "changelog_estimate_mass", "label": "mcmc_fit.estimate_mass()", "file_type": "code", "source_file": "CHANGELOG.md", "source_location": "session 2", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Pairs each posterior tE sample with a Monte Carlo draw from assumed mu_rel/D_L priors to produce a full M_lens distribution rather than a point estimate, directly answering session 1's central open question. Flagged with a ponytail comment that the uniform-D_L/fixed-D_S prior is a naive line-of-sight prior, not a real Galactic density model; a disk/bulge-weighted prior (Han & Gould 2003) is the documented upgrade path if the mass distribution's shape ever needs to be quantitatively trustworthy."}], "edges": [{"source": "changelog_session_2", "target": "changelog_session_1", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "CHANGELOG.md", "source_location": "session 2, Learned", "weight": 1.0}, {"source": "changelog_session_4", "target": "changelog_session_1", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "CHANGELOG.md", "source_location": "session 4, Learned", "weight": 1.0}, {"source": "changelog_session_4", "target": "changelog_session_2", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "CHANGELOG.md", "source_location": "session 4, Learned", "weight": 1.0}, {"source": "changelog_session_5", "target": "changelog_session_4", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "CHANGELOG.md", "source_location": "session 5, Learned", "weight": 1.0}, {"source": "changelog_session_6", "target": "changelog_session_5", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "CHANGELOG.md", 