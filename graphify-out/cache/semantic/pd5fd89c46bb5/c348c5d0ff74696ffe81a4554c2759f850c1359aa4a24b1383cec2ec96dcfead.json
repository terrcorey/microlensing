{"nodes": [{"id": "readme_document", "label": "README.md", "file_type": "document", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_mass_distance_degeneracy", "label": "tE mass-distance-velocity degeneracy", "file_type": "rationale", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A microlensing timescale tE alone conflates the angular Einstein radius and the relative proper motion, so it can't separate a lens's mass from its distance without finite-source effects, parallax, or an independent proper motion measurement -- exactly why brown-dwarf-mass lenses are hard to identify/characterize from microlensing alone. The whole pipeline (model, priors, derived quantities) exists to make this degeneracy visible rather than hide it behind a single confident point estimate."}], "edges": [{"source": "readme_document", "target": "dataset_names_o05blg086", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "README.md", "source_location": null, "weight": 1.0}, {"source": "readme_document", "target": "dataset_names_o03blg235", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "README.md", "source_location": null, "weight": 1.0}, {"source": "readme_document", "target": "claude_pspl_model", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "README.md", "source_location": null, "weight": 1.0}, {"source": "readme_document", "target": "dataset_names_document", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "README.md", "source_location": null, "weight": 1.0}, {"source": "readme_document", "target": "changelog_wyrzykowski_2015", "relation": "cites", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "READ