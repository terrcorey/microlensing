{"nodes": [{"id": "claude", "label": "CLAUDE.md", "file_type": "document", "source_file": "CLAUDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "claude_config_driven_pipeline", "label": "Config-driven pipeline (input/<short>.toml -> search.py)", "file_type": "rationale", "source_file": "CLAUDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Long-term direction: point at a new event's data + config and get the full treatment (MCMC, corner plots, derived quantities); favor parameterized functions over hardcoded per-event constants."}, {"id": "claude_toml_event_config", "label": "Per-event TOML config (input/<short>.toml)", "file_type": "concept", "source_file": "CLAUDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "No literature initial guesses; instruments list with kind/band/K/ld/time_fmt."}, {"id": "claude_instrument_kind_mag_dia", "label": "Instrument kind: mag (fs*A+fb) vs dia (fs*(A-1))", "file_type": "concept", "source_file": "CLAUDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "DIA flux is relative to a template with no shared zero point, so blend cancels and only fs is profiled."}, {"id": "claude_blind_search", "label": "Blind search stages (i)-(vi): FSPL fit, (s,q) grid, local minima, refinement+emcee, delta-chi2 map+BIC, diagnose", "file_type": "concept", "source_file": "CLAUDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Data-seeded only; literature values used for validation, never seeds."}, {"id": "claude_point_source_grid", "label": "Point-source (rho=0, VBBL BinaryMag0) grid scoring", "file_type": "rationale", "source_file": "CLAUDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Finite-source cost was heavy-tailed (<1% of calls through on-axis cusps took ~half a cell's time, up to 109 s); point source gives constant ~11 s/cell."}, {"id": "claude_grid_checkpointing", "label": "Grid checkpointing (grid_partial.npz, resumable)", "file_type": "concept", "source_file": "CLAUDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "claude_vbbinarylensing", "label": "VBBinaryLensing magnification backend", "file_type": "concept", "source_file": "CLAUDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Frame matches binary_trajectory(); ~100x faster than binary_magnification_fs via contour integration; own implementation kept as cross-check."}, {"id": "claude_cassan_parametrisation", "label": "Cassan (2008) caustic-crossing parametrisation", "file_type": "concept", "source_file": "CLAUDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Answer to the near-miss-cusp search problem: every trial crosses the caustic by construction."}, {"id": "claude_near_miss_cusp_problem", "label": "Near-miss cusp search problem", "file_type": "concept", "source_file": "CLAUDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Multi-start/MCMC converged to non-physical solutions with no 3->5 image transition that scored better than Bond's chi2; only caught by image-count check."}, {"id": "claude_finite_source_fs", "label": "Finite-source 2L1S (binary_magnification_fs, Fibonacci-spiral disk average, gated)", "file_type": "concept", "source_file": "CLAUDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Sunflower spiral chosen over equal-area rings (no central hole); gating only near caustics gives ~70x speedup."}, {"id": "claude_annual_parallax", "label": "Annual parallax (Gould 2004 geocentric, piE_N/piE_E, t0_par)", "file_type": "concept", "source_file": "CLAUDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Plain PSPL residuals clustered in time windows, consistent with unmodeled physics; t0_par fixed at preliminary non-parallax t0."}, {"id": "claude_student_t_likelihood", "label": "Robust Student-t likelihood (free scale, dof)", "file_type": "rationale", "source_file": "CLAUDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Residuals globally heavier-tailed than Gaussian rather than a few discrete outliers, so smooth down-weighting beats Huber/sigma clipping."}, {"id": "claude_huber_likelihood", "label": "Huber loss likelihood (DELTA=1.345)", "file_type": "concept", "source_file": "CLAUDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Fixed delta so no normalizing-constant correction needed; tried alongside chi2/Student-t, none captured the caustic spike."}, {"id": "claude_calibrate_once_then_fit", "label": "O-03-BLG235 calibrate-once-then-fit pipeline (preprocess_binary_data.py)", "file_type": "concept", "source_file": "CLAUDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "OGLE mag and MOA DIA flux are incompatible; convert both to magnification via joint PSPL calibration. Freezes calibration so posteriors are too tight."}, {"id": "claude_profiled_flux_calibration", "label": "Per-trial profiled flux calibration (weighted lstsq fs/fb)", "file_type": "rationale", "source_file": "CLAUDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Frozen PSPL calibration was biased for a caustic-crossing trajectory (chi2 31,982 vs 1,953 at Bond's params), so fs/fb are re-solved per trial."}, {"id": "claude_error_bar_rescaling", "label": "Error-bar rescaling (per-instrument K, chi2/dof=1)", "file_type": "concept", "source_file": "CLAUDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "No error floor: bright OGLE points already under-contribute; floor undefined for zero-point-free DIA flux. K set at 2L1S best fit introduces circularity, so BIC also reported with FSPL-derived k."}, {"id": "claude_bic_model_comparison", "label": "PSPL/FSPL vs 2L1S BIC model comparison", "file_type": "concept", "source_file": "CLAUDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Delta BIC 571.6 in favour of 2L1S for O-03-BLG235 on a shared footing (same points, errors, profiled flux, no parallax)."}, {"id": "claude_u0_sign_degeneracy", "label": "u0 sign degeneracy / per-dataset initial guesses", "file_type": "rationale", "source_file": "CLAUDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "PSPL depends only on u0 squared; reusing another dataset's guess converged to the mirror solution with an artificially tight posterior."}, {"id": "claude_twol1sparams", "label": "TwoL1SParams NamedTuple (canonical 2L1S param order)", "file_type": "concept", "source_file": "CLAUDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Prevents silent param-order swaps like session 10's s/q vs piE bug."}, {"id": "claude_fitresult", "label": "mcmc_fit.FitResult NamedTuple (best_fit, samples, labels)", "file_type": "concept", "source_file": "CLAUDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Bundles samples with labels so a caller can't pair samples with wrong labels."}, {"id": "claude_shared_plot_helpers", "label": "Shared plotting/MCMC helpers (plot_fit_panels, plot_residual_panel, save_corner, plot_fit_lc, get_t0_par)", "file_type": "rationale", "source_file": "CLAUDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Call, don't copy; raw residuals with real per-point errors keep OGLE's precision visible vs MOA."}, {"id": "claude_scratch_separation", "label": "scratch/ vs results/ output layout", "file_type": "rationale", "source_file": "CLAUDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "One-time/dev code and output kept in scratch/; graduate code and output paths together."}, {"id": "claude_login_node_rule", "label": "Login node vs compute nodes (hypatia: srun/sbatch)", "file_type": "rationale", "source_file": "CLAUDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Shared login node; any fit/MCMC/pool goes to srun --partition=small-short or sbatch; PYTHON_CPU_COUNT exported."}, {"id": "claude_slurm_jobs", "label": "SLURM job scripts (slurm/*.sbatch, submit_all.sh)", "file_type": "concept", "source_file": "CLAUDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "CPU not GPU: per-walker OS processes would serialize on a shared GPU context."}, {"id": "claude_spawn_context_pool", "label": "Spawn-context process pools", "file_type": "rationale", "source_file": "CLAUDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Forking after torch spins up its thread pool can deadlock a second pool."}, {"id": "claude_mass_distance_degeneracy", "label": "Mass-distance-velocity degeneracy (tE)", "file_type": "concept",