{"nodes": [{"id": "claude_doc", "label": "CLAUDE.md", "file_type": "document", "source_file": "CLAUDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "claude_o_05_blg086", "label": "O-05-BLG086 (OGLE-2005-BLG-086)", "file_type": "concept", "source_file": "CLAUDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "claude_o_03_blg235", "label": "O-03-BLG235 (OGLE-2003-BLG-235 / MOA-2003-BLG-53)", "file_type": "concept", "source_file": "CLAUDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "claude_pspl_model", "label": "PSPL (point-source point-lens) model", "file_type": "concept", "source_file": "CLAUDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "claude_2l1s_model", "label": "2L1S (point-source binary-lens) model", "file_type": "concept", "source_file": "CLAUDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "claude_annual_parallax", "label": "Annual parallax (Gould 2004 geocentric formalism)", "file_type": "concept", "source_file": "CLAUDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Plain PSPL didn't fit real data well (O-05-BLG086: chi2/dof=2.14, residuals clustered in time windows) -- motivated adding piE_N/piE_E via Earth's orbital motion rather than accepting the unmodeled-physics residual pattern."}, {"id": "claude_student_t_likelihood", "label": "Student-t robust likelihood", "file_type": "concept", "source_file": "CLAUDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Chosen over Huber/sigma-clipping because the residual diagnostic showed a globally heavier-than-Gaussian error distribution (moderate excess kurtosis, MLE dof~6), not a small discrete outlier population -- a smooth down-weight fits the failure mode better than a hard cut."}, {"id": "claude_calibrate_once_pipeline", "label": "O-03-BLG235 calibrate-once-then-fit pipeline", "file_type": "rationale", "source_file": "CLAUDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "OGLE (calibrated magnitude) and MOA (template-relative differential flux) can't be compared directly, so a joint PSPL fit is run once to invert both onto a shared magnification A(t) scale; this freezes the flux calibration at a point estimate, tightening downstream posteriors by not propagating calibration uncertainty -- and was later shown to bias 2L1S searches (chi2 31,982 vs 1,953 at Bond et al.'s parameters)."}, {"id": "claude_scratch_convention", "label": "scratch/ one-time-script convention", "file_type": "rationale", "source_file": "CLAUDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Keeps one-time/dev-script code and its output separated from the regular pipeline so scratch experiments (2L1S search, MulensModel cross-checks) don't pollute the canonical output directories; a script's code and output path move out together only when it graduates into the pipeline."}, {"id": "claude_output_layout", "label": "Output layout convention", "file_type": "rationale", "source_file": "CLAUDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "raw_lc/, fit_lc/, hist_plots/, corner_plots/ hold only the regular pipeline's canonical outputs; everything from scratch/ scripts writes there instead, enforcing the same code/output separation as the scratch/ convention."}, {"id": "claude_shared_helpers_note", "label": "Shared plotting/MCMC helpers (\"do not re-copy\")", "file_type": "rationale", "source_file": "CLAUDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Prefer one shared implementation over copy-pasted plotting/MCMC logic across scripts -- but explicitly warns against forcing an abstraction over a real difference: plot_fit_panels() was deliberately NOT built on the standardized-residual helpers because that would have hidden OGLE's real ~4x-better photometric precision behind MOA's when both instruments shared one panel (caught by the user, not by inspection)."}, {"id": "claude_fitresult_pattern", "label": "FitResult NamedTuple pattern", "file_type": "rationale", "source_file": "CLAUDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Bundles samples with their own column labels via a .column(name) method so a caller can't pair a samples array with the wrong labels constant -- replaced module-level PLAIN_LABELS/PARALLAX_LABELS/LABELS constants after that exact mismatch caused a live IndexError in mcmc_fit_binary.py."}, {"id": "claude_get_t0_par_pattern", "label": "get_t0_par() cache-bootstrap pattern", "file_type": "rationale", "source_file": "CLAUDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Replaced an inline try/except cache block that silently computed t0_par two different ways (posterior median on cache hit, curve_fit point estimate on cache miss) depending on whether a file happened to exist -- a self-contained function now always returns the posterior median regardless of machine state."}, {"id": "claude_near_miss_cusp_problem", "label": "Near-miss cusp solution search problem", "file_type": "rationale", "source_file": "CLAUDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "After the calibration bug was fixed, multi-start and most MCMC runs converge to non-physical trajectories that never cross the caustic (no 3->5 image-count transition) yet score numerically better than Bond et al.'s published chi2 -- only catchable via the image-count check, not chi2 alone; still open as of session 9."}, {"id": "claude_moa19008_error_bar_issue", "label": "MOA-2019-BLG-008 mag_err underestimation", "file_type": "rationale", "source_file": "CLAUDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Raw KMT mag_err column (median 0.006 mag) understates real point-to-point scatter (~0.1-0.2 mag) by 16-49x, a known property of raw KMTNet/pySIS photometry -- confirmed model-independently via a flat-line baseline fit (chi2/dof=2441) before ever indicting the lensing model itself; needs error-bar rescaling before fits mean anything, still unaddressed."}, {"id": "claude_dataset_guard_pattern", "label": "Per-dataset DATASETS dict guard", "file_type": "rationale", "source_file": "CLAUDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "u0_guess/tE_guess are required, dataset-specific arguments (no shared default) kept in a DATASETS dict keyed by short name, specifically so a second dataset entry can't silently reproduce session 1's u0-sign bug."}, {"id": "claude_rules_immutability_rule", "label": "Rule: never edit rules/instructions sections", "file_type": "rationale", "source_file": "CLAUDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "claude_no_git_commits_rule", "label": "Rule: never git commit/push", "file_type": "rationale", "source_file": "CLAUDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "claude_outside_folder_rule", "label": "Rule: ask permission for files outside microlensing/", "file_type": "rationale", "source_file": "CLAUDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "claude_ponytail_gate_rule", "label": "Rule: confirm ponytail active before writing/editing code", "file_type": "rationale", "source_file": "CLAUDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "claude_guiding_role_rule", "label": "Rule: Claude acts in guiding role, user writes code", "file_type": "rationale", "source_file": "CLAUDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "claude_ponytail_skill", "label": "ponytail skill", "file_type": "concept", "source_file": "CLAUDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "claude_grill_me_skill", "label": "/grill-me skill", "file_type": "concept", "source_file": "CLAUDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "claude_graphify_skill", "label": "/graphify skill", "file_type": "concept", "source_file": "CLAUDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "claude_gould_2004", "label": "Gould (2004) parallax formalism", "file_type": "paper", "source_file": "CLAUDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "claude_sympy_dep", "label": "sympy (scratch-only dev dependency)", "file_type": "concept", "source_file": "CLAUDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Used once to symbolically derive the 2L1S quintic polynomial coefficients (removing transcription-error risk vs. hand-copying from Witt & Mao 1995), then the generated coefficients are hardcoded as plain numpy -- deliberately kept out of requirements.txt as a one-time dev tool, not a pipeline dependency."}, {"id": "claude_mulensmodel_dep", "label": "MulensModel (scratch-only oracle dependency)", "file_type": "concept", "source_file": "CLAUDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Used only as a trusted independent oracle to cross-check binary_magnification and the parallax trajectory, never as a pipeline dependency -- this project's raw data itself comes from MulensModel's redistribution of OGLE/MOA photometry, but 2L1S/parallax are hand-rolled deliberately for the learning value."}], "edges": [{"source": "claude_doc", "target": "changelog_doc", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "CLAUDE.md", "source_location": null, "weight": 1.0}, {"source": "claude_doc", "target": "requirements_doc", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "CLAUDE.md", "source_location": null, "weight": 1.0}, {"source": "claude_doc", "target": "claude_o_05_blg086", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "CLAUDE.md", "source_location": null, "weight": 1.0}, {"source": "claude_doc", "target": "claude_o_03_blg235", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "CLAUDE.md", "source_location": null, "weight": 1.0}, {"source": "claude_gould_2004", "target": "claude_annual_parallax", "relation": "cites", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "CLAUDE.md", "source_location": null, "weight": 1.0}, {"source": "claude_pspl_model", "target": "claude_o_05_blg086", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "CLAUDE.md", "source_location": null, "weight": 1.0}, {"source": "claude_pspl_model", "target": "claude_o_03_blg235", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_scor