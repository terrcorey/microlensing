{"nodes": [{"id": "claude_document", "label": "CLAUDE.md", "file_type": "document", "source_file": "CLAUDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "claude_pspl_model", "label": "Point-Source Point-Lens (PSPL) model", "file_type": "concept", "source_file": "CLAUDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "claude_2l1s_model", "label": "Point-Source Binary-Lens (2L1S) model", "file_type": "concept", "source_file": "CLAUDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "claude_parallax_student_t_plan", "label": "Annual parallax + Student-t likelihood plan", "file_type": "rationale", "source_file": "CLAUDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The plain Gaussian PSPL model doesn't fit real data well (O-05-BLG086: chi2/dof=2.14, standardized-residual std=1.46, moderate excess kurtosis 1.23, largest residuals clustering in specific time windows rather than scattering randomly) -- consistent with unmodeled physics (parallax) plus a globally heavier-than-Gaussian error distribution rather than bad photometry or a small discrete-outlier population. Two changes planned to replace the model outright (no flag/toggle) across every PSPL-based fit: annual parallax (Gould 2004 geocentric piE_N/piE_E via astropy) built first, then a Student-t likelihood (scale and dof both free) built second, chosen over Huber/sigma-clipping specifically because the heavy tails look global rather than a small outlier population."}, {"id": "changelog_mulensmodel", "label": "MulensModel package", "file_type": "concept", "source_file": "CLAUDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Used only as a one-time, trusted-oracle cr