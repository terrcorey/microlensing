{"nodes": [{"id": "readme_doc", "label": "README.md", "file_type": "document", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_mass_distance_degeneracy", "label": "Mass-distance-velocity degeneracy (central open question)", "file_type": "rationale", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "tE alone conflates the angular Einstein radius and relative proper motion, so it can't fix a lens mass or distance without finite-source effects, parallax, or independent proper motion -- this is exactly why brown-dwarf-mass lenses are hard to identify from microlensing alone; the whole project exists to make this degeneracy visible, not hide it behind a point estimate."}, {"id": "readme_lens_mass_prior", "label": "Prior-based lens mass estimate (M_lens)", "file_type": "rationale", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Pairs each posterior tE sample with Monte Carlo draws from assumed mu_rel (log-normal) and D_L (naive uniform line-of-sight, not a real Galactic density model) priors, since tE alone can't fix mass. Explicitly flagged as the single biggest caveat in the pipeline and only illustrative, not a real mass measurement."}], "edges": [{"source": "readme_doc", "target": "changelog_doc", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "README.md", "source_location": null, "weight": 1.0}, {"source": "readme_doc", "target": "requirements_doc", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "README.md", "source_location": null, "weight": 1.0}, {"source": "readme_doc", "target": "claude_doc", "relation": "semantically_similar_to", "confidence": "INFERRED", "confidence_score": 0.85, "sou