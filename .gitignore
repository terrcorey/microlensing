__pycache__/
*.pyc
.venv/
.venv-mulens/

# raw + derived photometry; download_data.py / preprocess_binary_data.py regenerate these
data/

# every pipeline output, regenerated by its script (see CLAUDE.md "Output layout")
results/
# scratch/ mixes one-time scripts with their own plot output -- only ignore the plots
*.png
# scratch search/probe output: injection runs (inputs + truth.npz stay tracked), sensitivity maps, stall_probe logs
scratch/injections/*/inj*/out_*/
scratch/sensitivity/*.npz
scratch/stall_probe/*.log
scratch/stall_probe/*.out
scratch/stall_probe/*.err

# SLURM job logs (slurm/submit_all.sh)
slurm/output/
slurm/errors/
